# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Example: APP_URL="http://147.93.99.188:3000"
APP_URL="MY_APP_URL"

# Razorpay
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MySQL Database
# IMPORTANT: For Hostinger/CPanel, you MUST whitelist '%' in "Remote MySQL" settings.
MYSQL_HOST=147.93.99.163
MYSQL_USER=u674305543_bvo9165436918
MYSQL_PASSWORD=Tarun@_9165
MYSQL_DATABASE=u674305543_bvo9165436918
MYSQL_PORT=3306
# Set MYSQL_SSL=true only if your MySQL server requires an encrypted connection and supports it.
MYSQL_SSL=false

# Google Maps (Requires 'Maps JavaScript API' to be enabled in Google Cloud Console)
# If you see 'ApiProjectMapError', go to:
# 1. Google Cloud Console -> APIs & Services -> Library
# 2. Search for 'Maps JavaScript API' and click 'Enable'
# 3. Ensure billing is linked to your project.
VITE_GOOGLE_MAPS_API_KEY=

# Storage (Optional)
# Set UPLOAD_DIR to an absolute path on your server outside the build folder
# to ensure user-uploaded files are not lost when you redeploy.
# Example: UPLOAD_DIR="/var/www/my-app-uploads"
UPLOAD_DIR=
